# Safe defaults for the opt-in local catalogue worker. Copy this file to
# .local/env/catalogue-worker.env and change only capabilities the owner has approved.
APP_DATABASE_URL=postgresql+psycopg://scholarship:scholarship@db:5432/scholarship

APP_CATALOGUE_WORKER_POLL_SECONDS=30
APP_CATALOGUE_WORKER_HEALTH_REQUIRED=true
APP_CATALOGUE_WORKER_KILL_SWITCH_PATH=/run/catalogue/STOP
# The worker's /tmp tmpfs is 512 MiB; require at least half to remain free.
APP_CATALOGUE_WORKER_MIN_FREE_DISK_BYTES=268435456

APP_CATALOGUE_AI_INGESTION_ENABLED=false
APP_CATALOGUE_AI_PROVIDER=unavailable
APP_CATALOGUE_AI_MODEL=unconfigured
# APP_CATALOGUE_AI_ENDPOINT=https://<resource>.openai.azure.com
# APP_CATALOGUE_AI_CAPABILITY_RECEIPT_PATH=/run/catalogue/model-capability.json
APP_CATALOGUE_AI_TIMEOUT_SECONDS=30
APP_CATALOGUE_AI_MAX_CANDIDATES_PER_RUN=1
APP_CATALOGUE_AI_MAX_PAGES_PER_CANDIDATE=12
APP_CATALOGUE_AI_MAX_CALLS_PER_RUN=60
APP_CATALOGUE_AI_MAX_INPUT_CHARACTERS=80000
APP_CATALOGUE_AI_MAX_OUTPUT_TOKENS=12000
APP_CATALOGUE_AI_MAX_ESTIMATED_COST_PER_RUN=5.00
APP_CATALOGUE_AI_MAX_RETRIES=0
APP_CATALOGUE_AI_INPUT_COST_PER_MILLION=0
APP_CATALOGUE_AI_OUTPUT_COST_PER_MILLION=0

APP_CATALOGUE_BOUNDED_CRAWLING_ENABLED=true
APP_CATALOGUE_CRAWLEE_STATIC_ENABLED=false
APP_CATALOGUE_DOCUMENT_INTELLIGENCE_ENABLED=false
APP_CATALOGUE_DOCUMENT_OCR_ENABLED=false
APP_CATALOGUE_SOURCE_ROUTING_ENABLED=true

# These capabilities remain off for the first pilot.
APP_CATALOGUE_WEB_DISCOVERY_ENABLED=false
APP_CATALOGUE_BROWSER_FETCHING_ENABLED=false
APP_CATALOGUE_SCHEDULED_INGESTION_ENABLED=false
APP_CATALOGUE_GRAPH_READS_ENABLED=false
APP_CATALOGUE_GRAPH_WRITES_ENABLED=false

# Comma-separated, manually reviewed owner domains. Fetch permission is not
# evidence verification and does not publish an opportunity.
APP_CATALOGUE_REVIEWED_OFFICIAL_DOMAINS=

# DefaultAzureCredential is used when AI is explicitly enabled. Supply its
# AZURE_* environment values only in .local/env/catalogue-worker.env.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
