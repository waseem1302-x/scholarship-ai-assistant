APP_ENV=development
APP_DEBUG=false
APP_DATABASE_URL=postgresql+psycopg://scholarship:scholarship@db:5432/scholarship
# Production migrations use a separately scoped credential. Local development
# can leave this blank and uses APP_DATABASE_URL.
# APP_MIGRATION_DATABASE_URL=postgresql+psycopg://scholarship_migrator:secret@db:5432/scholarship
# Only the isolated Azure Alembic job sets this. It receives no API, SMTP,
# Redis, or JWT secrets.
# APP_MIGRATION_ONLY=false
APP_JWT_SECRET=replace-with-at-least-32-random-characters
# JWT key rotation: issue new tokens with APP_JWT_SECRET and a new key ID,
# retain prior key IDs in the JSON map until their tokens expire.
APP_JWT_ACTIVE_KID=current
# APP_JWT_VERIFICATION_KEYS={"previous":"previous-at-least-32-character-secret"}
# APP_JWT_LEGACY_VERIFICATION_SECRET=old-secret-for-pre-kid-tokens
APP_JWT_ISSUER=scholarship-ai-assistant
APP_JWT_AUDIENCE=scholarship-ai-api
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=30
APP_AUTH_TOKEN_RETENTION_DAYS=30
APP_CORS_ORIGINS=http://localhost:3000
# Defaults to true in production; keep false only for local HTTP development.
APP_COOKIE_SECURE=false
APP_OPERATIONAL_JOB_STALE_MINUTES=15
# Phase 9 release / beta policy. Production rejects the unsafe defaults.
APP_RELEASE_VERSION=development
APP_BETA_ENABLED=false
APP_BETA_REGISTRATION_OPEN=false
APP_BETA_MAX_ACTIVE_STUDENTS=25
APP_CATALOGUE_MAINTENANCE_MODE=false
APP_ASSISTANT_ENABLED=true
APP_COMMUNITY_ENABLED=false
# APP_BETA_PRODUCT_OWNER_CONTACT=
# APP_BETA_SUPPORT_CONTACT=
# APP_BETA_MODERATION_CONTACT=
# APP_BETA_DATA_QUALITY_CONTACT=
# APP_BETA_INCIDENT_CONTACT=
# APP_TRUSTED_PROXY_IPS=10.0.0.10
# Azure Container Apps has a dedicated safe adapter. It uses the platform's
# rightmost X-Forwarded-For value rather than trusting browser-supplied values.
# APP_TRUSTED_PROXY_MODE=azure-container-apps
# Shared limiter: production requires Redis. Keep memory only for local/test.
APP_RATE_LIMIT_BACKEND=memory
# APP_RATE_LIMIT_REDIS_URL=redis://:secret@redis:6379/0
# Dedicated authentication-abuse limiters (all windows are one minute).
APP_AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Global defensive circuit breaker for distributed login attacks.
APP_AUTH_LOGIN_GLOBAL_RATE_LIMIT_PER_MINUTE=300
APP_AUTH_REGISTRATION_RATE_LIMIT_PER_MINUTE=5
APP_ACCOUNT_RECOVERY_RATE_LIMIT_PER_MINUTE=5
APP_ACCOUNT_VERIFICATION_RATE_LIMIT_PER_MINUTE=10
APP_ADMIN_REAUTHENTICATION_RATE_LIMIT_PER_MINUTE=5
APP_WEBAUTHN_RATE_LIMIT_PER_MINUTE=10
# Production requires the Pwned Passwords k-anonymity check. Local/test may
# disable it when no approved outbound service is available.
APP_PASSWORD_BREACH_CHECK_ENABLED=false
APP_PASSWORD_BREACH_CHECK_URL=https://api.pwnedpasswords.com/range
APP_PASSWORD_BREACH_CHECK_TIMEOUT_SECONDS=3
APP_PASSWORD_BREACH_CHECK_FAIL_CLOSED=true
# Transactional account email: production requires reviewed SMTP settings.
APP_EMAIL_PROVIDER=unconfigured
# APP_EMAIL_FROM=Scholarship AI <support@example.org>
# APP_EMAIL_SMTP_HOST=smtp.example.org
# APP_EMAIL_SMTP_PORT=587
# APP_EMAIL_SMTP_USERNAME=
# APP_EMAIL_SMTP_PASSWORD=
# APP_WEBAUTHN_RP_ID=beta.example.org
# APP_WEBAUTHN_ORIGINS=https://beta.example.org
# Server-side assistant configuration. Leave the API key unset for the safe local evidence-template provider.
APP_ASSISTANT_PROVIDER=evidence-template
APP_ASSISTANT_MODEL=evidence-template-v1
# Required only by a reviewed remote provider adapter; set it through a secret manager.
# APP_ASSISTANT_API_KEY=
APP_ASSISTANT_DAILY_USER_LIMIT=30
APP_ASSISTANT_MONTHLY_USER_LIMIT=300
APP_ASSISTANT_RATE_LIMIT_PER_MINUTE=12
APP_ASSISTANT_HISTORY_RETENTION_DAYS=30
APP_ASSISTANT_FEEDBACK_RETENTION_DAYS=365
# Document Lab is disabled until encrypted storage, malware scanning, and a worker are configured.
APP_DOCUMENT_LAB_ENABLED=false
APP_DOCUMENT_LAB_STORAGE_PROVIDER=local-encrypted
APP_DOCUMENT_LAB_STORAGE_ROOT=./.document-lab-storage
APP_DOCUMENT_LAB_SCANNER_PROVIDER=unavailable
# APP_DOCUMENT_LAB_SCANNER_HOST=clamav
# APP_DOCUMENT_LAB_SCANNER_PORT=3310
# Required in production; use a Fernet-compatible 32-byte base64 secret from a secret manager.
# APP_DOCUMENT_LAB_ENCRYPTION_KEY=
# Production also requires a no-network isolated parser worker and an S3-compatible
# private bucket with a managed KMS key. Remote analysis stays off unless formally approved.
# APP_DOCUMENT_LAB_S3_BUCKET=
# APP_DOCUMENT_LAB_S3_REGION=
# APP_DOCUMENT_LAB_S3_ENDPOINT_URL=
# APP_DOCUMENT_LAB_S3_KMS_KEY_ID=
# APP_DOCUMENT_LAB_PARSER_ISOLATION_ENABLED=true
# APP_DOCUMENT_LAB_REMOTE_ANALYSIS_APPROVED=false
APP_DOCUMENT_LAB_MAX_UPLOAD_BYTES=10000000
APP_DOCUMENT_LAB_MAX_PAGES=50
APP_DOCUMENT_LAB_MAX_EXTRACTED_CHARACTERS=100000
APP_DOCUMENT_LAB_RETENTION_DAYS=30
APP_DOCUMENT_LAB_DAILY_ANALYSIS_LIMIT=10
APP_RETENTION_WORKER_POLL_SECONDS=86400
APP_DOCUMENT_LAB_PROVIDER=unavailable
