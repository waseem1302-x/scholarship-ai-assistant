# ==============================================================================
# SCHOLARSHIP AI ASSISTANT - CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# --- Application Core ---
APP_ENV=development                       # "development", "test", or "production"
APP_DEBUG=false
APP_DATABASE_URL=sqlite:///./scholarship.db # Or postgresql+psycopg://user:password@localhost:5432/scholarship
APP_JWT_SECRET=super-secret-key-at-least-32-characters-long-change-in-prod
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- 1-Click Social Authentication (Google & Facebook) [100% FREE] ---
# Get your Google Client ID for free at https://console.cloud.google.com/
APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Get your Facebook App ID for free at https://developers.facebook.com/
APP_FACEBOOK_APP_ID=your_facebook_app_id

# --- AI Extraction & Catalogue Ingestion ---
# Enable when running live paid batch extractions on the 500+ scholarships
APP_CATALOGUE_AI_INGESTION_ENABLED=false
APP_CATALOGUE_AI_PROVIDER=azure_openai
APP_CATALOGUE_AI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
APP_CATALOGUE_AI_MODEL=gpt-4o-mini
APP_CATALOGUE_AI_MAX_ESTIMATED_COST_PER_RUN=25.00
APP_CATALOGUE_AI_INPUT_COST_PER_MILLION=0.15
APP_CATALOGUE_AI_OUTPUT_COST_PER_MILLION=0.60
